# Copy to .env (or export these directly)  never commit real values.
# Nothing in accounts/core/payments crashes if these are unset: LLM calls raise a
# catchable LLMNotConfigured, and PAYMENT_PROVIDER defaults to the stub adapter.
#
# GOTCHA 1  a *blank* value is not the same as an *absent* one. Vars whose code
# reads `os.environ.get("X", "some-default")` take the blank string when the key
# is present-but-empty, silently overriding the default. Some of those then
# crash (`int("")`, `Decimal("")`) or flip behavior (DJANGO_DEBUG= is not "1",
# so it turns DEBUG *off*). Every var below that has a real default is shown
# commented-out with that default as its value  uncomment to change it, don't
# blank it out. Vars safe to leave blank are shown uncommented and empty.
# GOTCHA 2  load_dotenv() will not override a var already exported in your
# shell (even blank). If an edit here doesn't seem to take, `echo $VAR` first.
#
# GO-LIVE (VPS) CHECKLIST  everything needed is in this file; no code edits:
#   1. DJANGO_SECRET_KEY   fresh random value
#   2. DJANGO_DEBUG=0  + DJANGO_ALLOWED_HOSTS=<your domain(s)>   (both required,
#      or every request 400s DisallowedHost)
#   3. DJANGO_CSRF_TRUSTED_ORIGINS + DJANGO_CORS_ALLOWED_ORIGINS  <https://domain>
#   4. SITE_URL + FRONTEND_URL  the real https:// URLs (used in emails/receipts)
#   5. PAYMENT_PROVIDER=lenco + LENCO_API_KEY + LENCO_PUBLIC_KEY +
#      LENCO_WEBHOOK_SECRET, then the first-live-test checklist in payments/lenco.py
#   6. ANTHROPIC_API_KEY  (until then Claude tools return a clean 503 and the
#      credit wallet still gates correctly with a 402)

# --- Django deployment (core_backend/settings.py) ---
# All four default to the current local-dev behavior, so leaving them unset
# changes nothing on the dev box.
# Blank/absent falls back to the built-in insecure dev key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# "1" = on. ANY other value (including blank) turns DEBUG off  see GOTCHA 1.
#DJANGO_DEBUG=1
# Comma-separated hostnames, no scheme. REQUIRED once DJANGO_DEBUG=0.
# e.g. coreripper.com,www.coreripper.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated, scheme INCLUDED. e.g. https://coreripper.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Comma-separated, scheme included. Empty + DEBUG=1 means allow-all (dev, where
# the static frontend is a different origin); empty + DEBUG=0 means no
# cross-origin calls at all, which is correct once the frontend is same-origin.
DJANGO_CORS_ALLOWED_ORIGINS=

# --- Public URLs (emails, receipts, digest/newsletter links) ---
# SITE_URL is this backend; FRONTEND_URL is where the static pages are served
# (a separate origin/port in dev, normally the same domain in production).
#SITE_URL=http://127.0.0.1:8000
#FRONTEND_URL=http://127.0.0.1:5500/frontend

# --- Database (core_backend/settings.py) ---
# Defaults match the local `corelom` role/database created for development.
DB_NAME=corelom
DB_USER=corelom
DB_PASSWORD=corelom_dev_pw
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery (monitors, news, hardware, digests, newsletter) ---
# db 0 = broker, db 1 = results, db 2 = Django cache (trial/quota counters).
#CELERY_BROKER_URL=redis://localhost:6379/0
#CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- WhatsApp alert sender (monitors app) ---
# Base URL of the Octavian bot's localhost-only internal send API; monitors/
# whatsapp.py appends /send. That bot is a separate Node process holding a live
# WhatsApp Web session, so on a VPS it may not be on this host  point this at
# wherever it runs. Leave commented to use the local default below.
# If it's unreachable or its WhatsApp session isn't linked, nothing breaks: the
# dashboard reports WhatsApp alerts as unavailable and email alerts continue.
#WHATSAPP_BOT_URL=http://127.0.0.1:3001

# --- Outgoing email ---
# PREFERRED: Resend. Paste the backend-only "Sending Access" API key (a
# separate key from the one used for the Gmail "Send mail as" aliases) and all
# outgoing mail goes over smtp.resend.com:465 as the coreripper.site addresses
# below. This takes priority over the Gmail vars whenever it is set.
RESEND_API_KEY=

# The domain the four sender addresses are built from. Override an individual
# sender only if you need a different display name or mailbox; each address
# must exist in Resend/Cloudflare or the send will bounce.
#EMAIL_DOMAIN=coreripper.site
#EMAIL_FROM_SECURITY=CoreRipper Security <security@coreripper.site>   # signup verification, password reset
#EMAIL_FROM_BILLING=CoreRipper Billing <billing@coreripper.site>      # receipts, renewal notices
#EMAIL_FROM_ALERTS=CoreRipper Alerts <alert@coreripper.site>          # monitor alerts, digests, newsletters
#EMAIL_FROM_SUPPORT=CoreRipper Support <support@coreripper.site>      # support tickets + acknowledgements

# FALLBACK: Gmail SMTP, used only when RESEND_API_KEY is blank. EMAIL is the
# Gmail address; PASSKEY is its Gmail App Password (Settings -> Security ->
# 2-Step Verification -> App passwords  NOT the account password, Gmail SMTP
# rejects that if 2FA is on). Gmail will only send as one of the addresses
# above if it's a verified "Send mail as" alias on that account.
# With neither transport configured, Django's console backend prints every
# email (verification codes included) to the runserver log instead.
EMAIL=
PASSKEY=

# --- LLM: free tier (core/llm.py) ---
# Primary provider  Groq by default.
LLM_API_KEY=
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=llama-3.3-70b-versatile

# Fallback provider  used automatically if the primary errors or isn't configured.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
#LLM_FALLBACK_MODEL=gemini-1.5-flash

# --- LLM: paid tier / credits (credits app) ---
# Unset = Claude tools return a clean 503; the credit wallet still returns 402
# correctly on a zero balance, so the whole economy stays testable offline.
ANTHROPIC_API_KEY=
# Config only  a model version is NEVER rendered in customer-facing copy.
#CLAUDE_MODEL=claude-sonnet-5
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Usage guardrails (core/quota.py, accounts/trial.py) ---
# $-spend ceilings for the FREE models only (Claude is metered in credits).
#PREMIUM_MONTHLY_CAP_USD=4.20
#GLOBAL_DAILY_BUDGET_USD=10.00
# Free-tier operations per user per day.
#FREE_DAILY_OP_LIMIT=50

# --- Sessions (accounts app: AuthToken expiry + Remember-Me refresh tokens) ---
# Bearer tokens expire after this many hours; "Remember Me" at login issues a
# rotating refresh token that silently renews them for this many days.
#AUTH_TOKEN_LIFETIME_HOURS=8
#REFRESH_TOKEN_LIFETIME_DAYS=60

# --- Payments (payments/__init__.py) ---
# stub | lenco | lipila. The Lenco adapter (payments/lenco.py) is fully wired:
# when the API key arrives, paste the SECRET key into LENCO_API_KEY, set
# PAYMENT_PROVIDER=lenco, restart  nothing else changes. Then run the
# first-live-test checklist at the top of payments/lenco.py.
#PAYMENT_PROVIDER=stub
LENCO_API_KEY=
# Public (publishable) key  the only Lenco key the browser ever sees; needed
# for card payments via the inline widget. Mobile money works without it.
LENCO_PUBLIC_KEY=
# Any long random string. The inbound webhook URL is
# /api/payments/webhook/lenco/<this value>/  the endpoint stays 404 (disabled)
# until this is set. Register the full HTTPS URL in the Lenco dashboard.
LENCO_WEBHOOK_SECRET=
# Optional overrides  only if the docs disagree with the defaults in lenco.py.
LENCO_BASE_URL=
LENCO_WIDGET_URL=
# No LIPILA_* vars: payments/lipila.py doesn't exist, so PAYMENT_PROVIDER=lipila
# raises on startup by design. Add the key here at the same time as the adapter.
# Card kill switch: cards stay fully wired but hidden in the UI until this is
# "1" (user decision  mobile money only for now). Blank counts as off.
PAYMENTS_CARD_ENABLED=0

# --- Exchange rate (payments/fx.py) ---
# Prices are set in USD; Zambian customers are charged the live-rate ZMW
# equivalent. Rate comes from free market-rate feeds (same mid-market rate
# Google Finance shows). Optional custom feed (must return {"rates":{"ZMW":x}}):
FX_API_URL=
# Last-resort rate when no live/stored rate exists (fresh install, offline):
#FX_FALLBACK_USD_ZMW=27.00

# --- News feed aggregator (news app) ---
# Who gets the "N drafts ready for review" digest (defaults to EMAIL above).
#NEWS_FEED_REVIEWER_EMAIL=
#NEWS_FEED_TRENDING_THRESHOLD=50
#NEWS_FEED_MAX_DRAFTS_PER_RUN=5

# --- Intelligent content engine (core/intel: image pipeline + auto-editor) ---
# Dedicated Gemini key for article analysis + the auto-editor. Separate from
# LLM_FALLBACK_* on purpose (editorial work must not touch the credit wallet).
# Unset => pipeline degrades to a best-effort search from the raw title.
INTEL_gen_news_gemini=
#INTEL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#INTEL_GEMINI_MODEL=gemini-flash-latest
# Google Custom Search image provider. Key defaults to INTEL_gen_news_gemini;
# GOOGLE_CSE_ID (the Programmable Search Engine "cx", with Image search + whole
# web enabled) is REQUIRED to turn on web image search. Without it the pipeline
# falls back to Wikimedia Commons automatically.
#GOOGLE_IMAGE_SEARCH_KEY=
GOOGLE_CSE_ID=
#INTEL_IMAGE_CONFIDENCE_THRESHOLD=0.60
#INTEL_AUTOEDIT_MIN_AGE_DAYS=7
#INTEL_AUTOEDIT_MAX_PER_RUN=10

# --- Google Sign-In (accounts/views.py: google_login_view) ---
# Blank disables the "Continue with Google" button; email/password is unaffected.
GOOGLE_CLIENT_ID=
