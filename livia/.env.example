# ============================================================================
# Livia bot configuration. Copy to `.env` and fill in. `.env` is gitignored.
# Every value here has a safe default in code, so an unset/blank var just falls
# back to the default — the bot still boots. Keys left blank disable that
# provider cleanly (no error reaches any chat).
# ============================================================================

# --- Identity & behaviour ---------------------------------------------------
BOT_NAME=Livia
# DM reply policy: 'all' = reply to every direct message (most social);
#                  'named' = only reply in DMs when addressed by name.
# Groups are ALWAYS named-only regardless of this setting.
LIVIA_DM_MODE=all

# --- AI providers (combine both to stretch free-tier limits) ----------------
# Groq is primary, Gemini is the fallback. Leave a key blank to disable it.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults are known-good free-tier ids):
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-flash-latest

# LLM tuning (optional)
# LLM_TIMEOUT_MS=12000
# LLM_MAX_TOKENS=400
# LLM_COOLDOWN_SEC=60        # how long to skip a provider after a 429
# LLM_CACHE_TTL_SEC=900      # response-cache lifetime

# --- Caching / data VPS -----------------------------------------------------
# Points at the Redis instance on the DATA VPS. If unset, the bot uses an
# in-process in-memory cache (fine for a single box / local dev). Use the
# PRIVATE network address, never a public IP. Include the password.
#   redis://:YOUR_PASSWORD@10.0.0.2:6380/0
REDIS_URL=
# MEMORY_MAX_TURNS=6
# MEMORY_TTL_SEC=21600

# --- Internal /send API (used by CoreRipper monitors) -----------------------
SEND_API_HOST=127.0.0.1
SEND_API_PORT=3001

# --- WhatsApp / runtime -----------------------------------------------------
# Chromium path for whatsapp-web.js (the Docker image sets this for you).
# CHROME_PATH=/usr/bin/chromium
# Python used for the offline fallback brain (image provides python3).
# PYTHON_PATH=python3
# Group id for the announcement broadcaster (optional).
# ANNOUNCE_GROUP_ID=1203xxxxxxxxxxxxx@g.us

# --- Flood guard (optional) -------------------------------------------------
# FLOOD_MAX=6
# FLOOD_WINDOW_SEC=10
