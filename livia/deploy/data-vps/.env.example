# Copy to `.env` in this directory (deploy/data-vps/.env). Gitignored.
REDIS_PASSWORD=change-me-to-a-long-random-string
# PRIVATE network IP of THIS (data) VPS that the code VPS will connect to.
# Use the private interface, never a public IP. 127.0.0.1 keeps it local-only.
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6380
